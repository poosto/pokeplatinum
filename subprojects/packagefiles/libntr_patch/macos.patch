+#ifndef SIM_G3_LIGHTS_H
+#define SIM_G3_LIGHTS_H
+
+#include <nitro/types.h>
+#include <nitro/fx/fx.h>
+#include <nitro/gx/gxcommon.h>
+
+#define SIM_G3_MAX_POINT_LIGHTS 32
+#define SIM_G3_MAX_GLOW_SPRITES 64
+
+/* A point light added on top of the DS lighting. Positions are in view space
+   (camera relative), the same space the position matrix puts vertices in. */
+typedef struct SIM_G3PointLight {
+    VecFx32 viewPos;
+    fx32 radius;
+    GXRgb color;
+} SIM_G3PointLight;
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Sets the point lights for the current frame. They are cleared when the frame's
+   buffers are swapped, so scenes that stop setting them (battles, menus) don't
+   inherit stale lights. */
+void SIM_G3_SetPointLights(const SIM_G3PointLight * lights, int count);
+
+/* A tiny glowing dot (a firefly) drawn on top of the 3D scene, snapped to the
+   DS pixel grid and hidden behind nearer geometry */
+typedef struct SIM_G3GlowSprite {
+    VecFx32 viewPos;
+    GXRgb color;
+} SIM_G3GlowSprite;
+
+/* Sets the glow sprites for the current frame. They're drawn at the end of the
+   frame, after the buffers are swapped, and replaced by the next frame's */
+void SIM_G3_SetGlowSprites(const SIM_G3GlowSprite * sprites, int count);
+
+/* Called on swap buffers, so the frame being finished draws its own sprites */
+void G3SIM_LatchGlowSprites(void);
+int G3SIM_GetGlowSprites(const SIM_G3GlowSprite ** sprites);
+
+/* Polygons drawn with this polygon ID glow with the frame's glow color, for
+   things like lit windows at night */
+#define SIM_G3_GLOW_POLYGON_ID 63
+
+/* Sets the glow color and strength for the current frame. Like the point
+   lights it's cleared when the buffers are swapped. Strength is 0 to FX32_ONE */
+void SIM_G3_SetGlow(GXRgb color, fx32 strength);
+
+/* Sets the glow uniforms for a batch drawn with the given polygon ID */
+void G3SIM_ApplyGlow(u8 polygonId);
+void G3SIM_ClearFrameGlow(void);
+
+/* Number of falloff steps, for a banded pixel art look. 0 for smooth falloff */
+void SIM_G3_SetPointLightBands(int bands);
+int SIM_G3_GetPointLightBands(void);
+
+/* Uploads the lights to the 3D shader if they changed */
+void G3SIM_UploadPointLights(void);
+
+/* Clears the per-frame lights. Called on swap buffers */
+void G3SIM_ClearFramePointLights(void);
+
+/* Debug: draw only the point light contribution on opaque 3D polygons */
+void SIM_G3_SetPointLightDebugView(BOOL enabled);
+BOOL SIM_G3_GetPointLightDebugView(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
