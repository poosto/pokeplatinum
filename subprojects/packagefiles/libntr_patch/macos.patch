diff --git a/libraries/sim/src/sim_g3_lights.cpp b/libraries/sim/src/sim_g3_lights.cpp
new file mode 100644
index 0000000..f296058
--- /dev/null
+++ b/libraries/sim/src/sim_g3_lights.cpp
@@ -0,0 +1,127 @@
+#include <simulator/sim_g3_lights.h>
+
+#ifdef SDK_BUILD_NX
+#include <glad/glad.h>
+#else
+#include <simulator/glad/glad.h>
+#endif
+
+#include <math.h>
+#include <string.h>
+
+#include <simulator/g3_handler.h>
+
+extern GLuint g3shaderProgramID;
+
+static SIM_G3PointLight sLights[SIM_G3_MAX_POINT_LIGHTS];
+static int sLightCount = 0;
+static int sBands = 8;
+static BOOL sDirty = TRUE;
+static BOOL sDebugView = FALSE;
+
+void SIM_G3_SetPointLights(const SIM_G3PointLight * lights, int count) {
+    if (count > SIM_G3_MAX_POINT_LIGHTS) {
+        count = SIM_G3_MAX_POINT_LIGHTS;
+    }
+    if (count < 0) {
+        count = 0;
+    }
+
+    memcpy(sLights, lights, sizeof(SIM_G3PointLight) * count);
+    sLightCount = count;
+    sDirty = TRUE;
+}
+
+void G3SIM_ClearFramePointLights(void) {
+    if (sLightCount != 0) {
+        sLightCount = 0;
+        sDirty = TRUE;
+    }
+}
+
+void SIM_G3_SetPointLightBands(int bands) {
+    sBands = bands < 0 ? 0 : bands;
+    sDirty = TRUE;
+}
+
+int SIM_G3_GetPointLightBands(void) {
+    return sBands;
+}
+
+static void AddLight(const SIM_G3PointLight * light, float * posRadius, float * color, int index) {
+    posRadius[index * 4 + 0] = FX_FX32_TO_F32(light->viewPos.x);
+    posRadius[index * 4 + 1] = FX_FX32_TO_F32(light->viewPos.y);
+    posRadius[index * 4 + 2] = FX_FX32_TO_F32(light->viewPos.z);
+    posRadius[index * 4 + 3] = FX_FX32_TO_F32(light->radius);
+    color[index * 3 + 0] = (float)(light->color & 0x1F) / 31.0f;
+    color[index * 3 + 1] = (float)((light->color >> 5) & 0x1F) / 31.0f;
+    color[index * 3 + 2] = (float)((light->color >> 10) & 0x1F) / 31.0f;
+}
+
+// Whether the light's sphere reaches into the view frustum of the current
+// projection, so off screen lights don't cost anything in the shader
+static BOOL IsLightInView(const SIM_G3PointLight * light) {
+    const G3SIM_Matrix_t * proj = G3SIM_GetProjectionMatrix();
+    float m[4][4];
+    for (int i = 0; i < 4; i++) {
+        for (int j = 0; j < 4; j++) {
+            m[i][j] = FX_FX32_TO_F32(proj->nums[i][j]);
+        }
+    }
+
+    float x = FX_FX32_TO_F32(light->viewPos.x);
+    float y = FX_FX32_TO_F32(light->viewPos.y);
+    float z = FX_FX32_TO_F32(light->viewPos.z);
+    float radius = FX_FX32_TO_F32(light->radius);
+
+    // Vertices are row vectors (v * M), so each clip component is a column of
+    // M and the frustum planes are w +/- x, y, z
+    for (int k = 0; k < 3; k++) {
+        for (int sign = -1; sign <= 1; sign += 2) {
+            float a = m[0][3] + sign * m[0][k];
+            float b = m[1][3] + sign * m[1][k];
+            float c = m[2][3] + sign * m[2][k];
+            float d = m[3][3] + sign * m[3][k];
+            float len = sqrtf(a * a + b * b + c * c);
+
+            if (len > 0.0f && (a * x + b * y + c * z + d) / len < -radius) {
+                return FALSE;
+            }
+        }
+    }
+    return TRUE;
+}
+
+void G3SIM_UploadPointLights(void) {
+    if (!sDirty) {
+        return;
+    }
+    sDirty = FALSE;
+
+    float posRadius[SIM_G3_MAX_POINT_LIGHTS * 4];
+    float color[SIM_G3_MAX_POINT_LIGHTS * 3];
+    int count = 0;
+
+    for (int i = 0; i < sLightCount; i++) {
+        if (IsLightInView(&sLights[i])) {
+            AddLight(&sLights[i], posRadius, color, count++);
+        }
+    }
+
+    glProgramUniform1i(g3shaderProgramID, glGetUniformLocation(g3shaderProgramID, "pointLightDebug"), sDebugView);
+    glProgramUniform1i(g3shaderProgramID, glGetUniformLocation(g3shaderProgramID, "numPointLights"), count);
+    glProgramUniform1i(g3shaderProgramID, glGetUniformLocation(g3shaderProgramID, "pointLightBands"), sBands);
+    if (count > 0) {
+        glProgramUniform4fv(g3shaderProgramID, glGetUniformLocation(g3shaderProgramID, "pointLightPosRadius"), count, posRadius);
+        glProgramUniform3fv(g3shaderProgramID, glGetUniformLocation(g3shaderProgramID, "pointLightColor"), count, color);
+    }
+}
+
+void SIM_G3_SetPointLightDebugView(BOOL enabled) {
+    sDebugView = enabled;
+    sDirty = TRUE;
+}
+
+BOOL SIM_G3_GetPointLightDebugView(void) {
+    return sDebugView;
+}
