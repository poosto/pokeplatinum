+// Adds a quad covering DS pixels [x, x+1) x [y, y+1) at the given depth
+static int AddGlowPixel(G3SIM_Vertex_t * verts, int x, int y, float depth, const float color[3], float intensity)
+{
+	float x0 = (float)x / 128.0f - 1.0f;
+	float x1 = (float)(x + 1) / 128.0f - 1.0f;
+	float y0 = (float)y / 96.0f - 1.0f;
+	float y1 = (float)(y + 1) / 96.0f - 1.0f;
+	const float corners[6][2] = { {x0, y0}, {x1, y0}, {x1, y1}, {x1, y1}, {x0, y1}, {x0, y0} };
+
+	for (int i = 0; i < 6; i++) {
+		G3SIM_Vertex_t * v = &verts[i];
+		memset(v, 0, sizeof(*v));
+		v->x = corners[i][0];
+		v->y = corners[i][1];
+		v->z = depth;
+		v->r = color[0] * intensity;
+		v->g = color[1] * intensity;
+		v->b = color[2] * intensity;
+		// Below 1 so the shader's point lights skip it; the blend keeps the
+		// framebuffer's alpha anyway
+		v->a = 0.5f;
+		v->vz = -1.0f;
+	}
+	return 6;
+}
+
+// Draws the frame's glow sprites (fireflies) additively, each a bright DS pixel
+// with a dimmer plus around it, depth tested against the scene
+static void DrawGlowSprites()
+{
+	const SIM_G3GlowSprite * sprites;
+	int count = G3SIM_GetGlowSprites(&sprites);
+	if (count == 0) {
+		return;
+	}
+
+	static G3SIM_Vertex_t verts[SIM_G3_MAX_GLOW_SPRITES * 5 * 6];
+	int numVerts = 0;
+	const G3SIM_Matrix_t * proj = G3SIM_GetProjectionMatrix();
+
+	for (int i = 0; i < count; i++) {
+		const VecFx32 * p = &sprites[i].viewPos;
+		fx32 clip[4];
+		for (int j = 0; j < 4; j++) {
+			clip[j] = FX_Mul(p->x, proj->nums[0][j]) + FX_Mul(p->y, proj->nums[1][j])
+			        + FX_Mul(p->z, proj->nums[2][j]) + proj->nums[3][j];
+		}
+		if (clip[3] <= 0) {
+			continue;
+		}
+
+		float ndcX = (float)clip[0] / (float)clip[3];
+		float ndcY = (float)clip[1] / (float)clip[3];
+		if (ndcX < -1.0f || ndcX > 1.0f || ndcY < -1.0f || ndcY > 1.0f) {
+			continue;
+		}
+
+		int px = (int)floorf((ndcX + 1.0f) * 128.0f);
+		int py = (int)floorf((ndcY + 1.0f) * 96.0f);
+		float depth = G3SIM_ClipToGLDepth(clip[2], clip[3]);
+		float color[3] = {
+			(float)(sprites[i].color & 0x1F) / 31.0f,
+			(float)((sprites[i].color >> 5) & 0x1F) / 31.0f,
+			(float)((sprites[i].color >> 10) & 0x1F) / 31.0f,
+		};
+
+		numVerts += AddGlowPixel(&verts[numVerts], px, py, depth, color, 1.0f);
+		numVerts += AddGlowPixel(&verts[numVerts], px - 1, py, depth, color, 0.4f);
+		numVerts += AddGlowPixel(&verts[numVerts], px + 1, py, depth, color, 0.4f);
+		numVerts += AddGlowPixel(&verts[numVerts], px, py - 1, depth, color, 0.4f);
+		numVerts += AddGlowPixel(&verts[numVerts], px, py + 1, depth, color, 0.4f);
+	}
+	if (numVerts == 0) {
+		return;
+	}
+
+	glProgramUniform1i(g3shaderProgramID, glGetUniformLocation(g3shaderProgramID, "useTexture"), 0);
+	glProgramUniform1i(g3shaderProgramID, glGetUniformLocation(g3shaderProgramID, "useFog"), 0);
+	G3SIM_ApplyGlow(0);
+
+	GLboolean cullEnabled = glIsEnabled(GL_CULL_FACE);
+	glDisable(GL_CULL_FACE);
+	glDepthMask(GL_FALSE);
+	// Add the color, leave the 3D layer's alpha alone for the compositor
+	glBlendFuncSeparate(GL_ONE, GL_ONE, GL_ZERO, GL_ONE);
+
+	DrawVerts(verts, numVerts);
+
+	glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+	glDepthMask(GL_TRUE);
+	if (cullEnabled) {
+		glEnable(GL_CULL_FACE);
+	}
