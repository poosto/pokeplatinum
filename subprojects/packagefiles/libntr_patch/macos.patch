+#include "simulator/sim_gui.hpp"
+#include "simulator/sim_rtc.h"
+
+#include "simulator/imgui/imgui.hpp"
+
+#include "gui_internal.hpp"
+
+#include <ctime>
+#include <format>
+#include <string>
+
+namespace SIM::GUI {
+
+static constexpr int MinutesPerDay = 24 * 60;
+
+static std::tm LocalTime(s64 offsetSeconds) {
+    std::time_t t = std::time(nullptr) + static_cast<std::time_t>(offsetSeconds);
+    return *std::localtime(&t);
+}
+
+void AppClockInit() {
+}
+
+void AppClockMain(bool * openState) {
+    ImGui::Begin("Clock", openState);
+
+    std::tm systemTime = LocalTime(0);
+    ImGui::Text("System time:  %02d:%02d:%02d", systemTime.tm_hour, systemTime.tm_min, systemTime.tm_sec);
+
+    bool overrideEnabled = RTC_SIM_IsTimeOverrideEnabled();
+    s64 offset = RTC_SIM_GetTimeOverrideOffset();
+
+    if(ImGui::Checkbox("Override in-game time", &overrideEnabled)) {
+        // Start from system time when enabling, and drop the offset when disabling
+        RTC_SIM_SetTimeOverride(overrideEnabled, 0);
+        offset = 0;
+    }
+
+    if(overrideEnabled) {
+        std::tm gameTime = LocalTime(offset);
+        ImGui::Text("In-game time: %02d:%02d:%02d", gameTime.tm_hour, gameTime.tm_min, gameTime.tm_sec);
+
+        int minutes = gameTime.tm_hour * 60 + gameTime.tm_min;
+        std::string label = std::format("{:02}:{:02}", minutes / 60, minutes % 60);
+
+        if(ImGui::SliderInt("Time of day", &minutes, 0, MinutesPerDay - 1, label.c_str())) {
+            // Shift the offset so the in-game clock reads the chosen time on the
+            // same day, then let it keep ticking from there
+            s64 currentSeconds = gameTime.tm_hour * 3600 + gameTime.tm_min * 60 + gameTime.tm_sec;
+            RTC_SIM_SetTimeOverride(TRUE, offset + static_cast<s64>(minutes) * 60 - currentSeconds);
+        }
+    }
+
+    ImGui::End();
+}
+
+}
