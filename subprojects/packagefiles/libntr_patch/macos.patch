+static volatile s64 sTimeOverrideOffset = 0;
+
+void RTC_SIM_SetTimeOverride(BOOL enabled, s64 offsetSeconds)
+{
+    sTimeOverrideOffset = offsetSeconds;
+    sTimeOverrideEnabled = enabled;
+}
+
+BOOL RTC_SIM_IsTimeOverrideEnabled(void)
+{
+    return sTimeOverrideEnabled;
+}
+
+s64 RTC_SIM_GetTimeOverrideOffset(void)
+{
+    return sTimeOverrideOffset;
+}
+
+static time_t getPCTimeT( void )
+{
+    time_t currentTime = time( NULL );
+    if (sTimeOverrideEnabled) {
+        currentTime += (time_t)sTimeOverrideOffset;
+    }
+    return currentTime;
+}
