@@ -0,0 +1,29 @@
+#include <simulator/sim_post_effects.h>
+
+static SIM_TiltShiftSettings sTiltShift = {
+    .enabled = TRUE,
+    .maxBlur = 2.0f,
+    .focusY = 0.5f,
+    .focusSize = 0.12f,
+};
+
+static BOOL sRequested = FALSE;
+static BOOL sActive = FALSE;
+
+void SIM_PostFX_Request(void) {
+    sRequested = TRUE;
+}
+
+
+SIM_TiltShiftSettings * SIM_PostFX_GetTiltShiftSettings(void) {
+    return &sTiltShift;
+}
+
+void G3SIM_PostFX_LatchFrame(void) {
+    sActive = sRequested;
+    sRequested = FALSE;
+}
+
+float G3SIM_PostFX_GetTiltShiftBlur(void) {
+    return sActive && sTiltShift.enabled ? sTiltShift.maxBlur : 0.0f;
+}
