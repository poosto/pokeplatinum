+u32 SIM_hashbuf(const u8 *buf, size_t len)
+{
+#if defined(__ARM_FEATURE_CRC32)
+      u32 crc = 0xFFFFFFFF;
+
+      for ( ; len >= 8; len -= 8, buf += 8)
+      {
+            u64 chunk;
+            memcpy(&chunk, buf, sizeof(chunk));
+            crc = __crc32cd(crc, chunk);
+      }
